                stats.intellect += 20;
                npcRelations.michael.level += 25;
                txt = "You slam your textbook on the desk before Michael. He smiles, 'You're on, Ifeoma!' You prep for WAEC dynamically. (+20 Intellect, +25 Michael Relationship)";
            } 
            else if (actionKey === 'gate_aura') {
                stats.aura += 25;
                stats.confidence += 15;
                if (selectedCharacterKey === 'michael') faceContainer.innerHTML = characterSVGs.michael.happy;
                txt = "You perform the ultimate Aura Walk. Other students whisper, 'That hoodie guy got infinite swagger!' (+25 Aura)";
            } 
            else if (actionKey === 'gate_greet_ifeoma') {
                npcRelations.ifeoma.level += 30;
                stats.confidence += 10;
                txt = "You slide down your hood partially, offering her a calm smile. Ifeoma blushes but smiles back, 'Hurry up, test starts soon!' (+30 Ifeoma Relation)";
            } 
            else if (actionKey === 'classroom_study') {
                stats.intellect += 30;
                stats.energy -= 15;
                txt = "You completely master the dynamic organic structures. Your brain cells are optimized for final WAEC battle! (+30 Intellect, -15 Energy)";
                activeQuests.find(q => q.id === 'waec').complete = true;
            } 
            else if (actionKey === 'classroom_puffpuff') {
                npcRelations.ifeoma.level += 25;
                npcRelations.michael.level += 25;
                stats.energy -= 10;
                txt = "You share your delicious puff puff snack. 'Wow, you're sweet!' she says with a bright smile. (+25 Relationship)";
            } 
            else if (actionKey === 'library_cheat') {
                stats.intellect += 30;
                npcRelations.amara.level += 20;
                inventory.push({ id: 'notes', name: '📂 Past Questions', type: 'item', value: 25, count: 1 });
                txt = "Amara hands you the key solutions. You hiddenly slide it in your backpack. 'Use it wisely,' she whispers. (+30 Intellect, Item added)";
            } 
            else if (actionKey === 'library_tattoo') {
                npcRelations.amara.level += 35;
                txt = "She traces her wrist tattoo and says, 'It's a symbol of infinite focus.' Her dark eyes sparkle. (+35 Amara Relation)";
            } 
            else if (actionKey === 'cafeteria_jollof') {
                stats.energy = Math.min(100, stats.energy + 45);
                txt = "The smokey Jollof Rice tastes legendary. Full stomach, full stamina! (+45 Energy)";
            } 
            else if (actionKey === 'cafeteria_prank') {
                stats.confidence += 25;
                stats.aura -= 15;
                txt = "You and Trevor drop a fake spider in the principal\'s chair. The students laugh hysterically, but you lose respect from teachers. (+25 Confidence, -15 Aura)";
            } 
            else if (actionKey === 'staffroom_talk') {
                if (stats.confidence >= 80) {
                    stats.aura += 20;
                    txt = "With supreme charisma, you make up an assignment story. The teacher nods: 'Alright, return to your seat.' (+20 Aura)";
                } else {
                    stats.aura -= 20;
                    txt = "You stutter! Isi Owu confiscates your badge. 'Detention after hours!' (-20 Aura)";
                }
            } 
            else if (actionKey === 'staffroom_sprint') {
                if (stats.speed >= 80) {
                    txt = "You turn around and sprint down the corridor like an anime champion! Escaped without traces!";
                } else {
                    stats.energy -= 20;
                    txt = "You tripped on the doorway and Isi Owu caught you. You did 30 frog jumps. (-20 Energy)";
                }
            }

            // Check if final boss criteria are met
            if (stats.intellect >= 105 && stats.aura >= 115) {
                triggerBossShowdownMessage();
                return;
            }

            // Update dialogues
            document.getElementById('labelDialogueText').innerText = txt;
            updateStatsBar();
            renderQuestLog();
            renderBackpack();
            renderRelationships();
        }

        // Boss Battle initialization
        function triggerBossShowdownMessage() {
            playSound('damage');
            const box = document.getElementById('labelDialogueText');
            box.innerHTML = `<span class="text-red-500 font-extrabold text-lg">"MICHAEL! IFEOMA! PRINCIPAL'S OFFICE, NOW!"</span> <br><br> The corridor walls shake! Isi Owu has entered his final WAEC Guardian Form, with floating calculators and red reports! prepare yourself.`;
            
            const actionContainer = document.getElementById('containerBranchOptions');
            actionContainer.innerHTML = `
                <button onclick="startBossShowdown()" class="w-full bg-gradient-to-r from-red-700 to-purple-800 text-white font-extrabold p-4 rounded-xl text-xs uppercase tracking-widest animate-pulse">
                    ⚠️ ENTER THE WAEC FINAL BATTLE VS ISI OWU
                </button>
            `;
        }

        // Render Active Quests List
        function renderQuestLog() {
            const container = document.getElementById('containerQuestItems');
            container.innerHTML = '';
            activeQuests.forEach(q => {
                const item = document.createElement('div');
                item.className = "flex items-center gap-2 text-xs text-stone-300";
                item.innerHTML = `
                    <i class="fa-solid ${q.complete ? 'fa-square-check text-green-500' : 'fa-square text-stone-600'}"></i>
                    <span class="${q.complete ? 'line-through text-stone-500' : ''}">${q.title}</span>
                `;
                container.appendChild(item);
            });
        }

        // Render Inventory backpack slots
        function renderBackpack() {
            const container = document.getElementById('containerBackpack');
            container.innerHTML = '';
            inventory.forEach((item, index) => {
                const slot = document.createElement('button');
                slot.className = "bg-[#1d0d17] border border-red-950 p-1.5 rounded-lg text-[10px] text-white hover:bg-red-900/30 transition";
                slot.innerText = item.name;
                slot.onclick = () => useInventoryItem(index);
                container.appendChild(slot);
            });
            // Fill empty slots
            for (let i = inventory.length; i < 4; i++) {
                const empty = document.createElement('div');
                empty.className = "bg-[#0f050b] border border-red-950/20 rounded-lg h-9 flex items-center justify-center text-[10px] text-stone-700";
                empty.innerText = "Empty";
                container.appendChild(empty);
            }
        }

        function useInventoryItem(index) {
            playSound('item');
            const item = inventory[index];
            if (item.id === 'jollof') {
                stats.energy = Math.min(100, stats.energy + item.value);
                document.getElementById('labelDialogueText').innerText = "You ate the smokey Jollof Rice from your backpack! Your stamina is fully restored. (+40 Energy)";
            } else if (item.id === 'cheat') {
                stats.intellect += item.value;
                document.getElementById('labelDialogueText').innerText = "You read over your quick Chemistry notes! Your intelligence levels spiked! (+15 Intellect)";
            }
            inventory.splice(index, 1);
            updateStatsBar();
            renderBackpack();
        }

        // Render Relationship status meters
        function renderRelationships() {
            const container = document.getElementById('containerRelationships');
            container.innerHTML = '';
            Object.keys(npcRelations).forEach(key => {
                const npc = npcRelations[key];
                const block = document.createElement('div');
                block.className = "space-y-1";
                block.innerHTML = `
                    <div class="flex justify-between text-[11px] font-semibold">
                        <span class="capitalize text-stone-300">${key} <span class="text-[9px] text-stone-500 font-normal">(${npc.tag})</span></span>
                        <span class="text-yellow-400">${npc.level}%</span>
                    </div>
                    <div class="w-full bg-stone-900 h-1.5 rounded-full overflow-hidden">
                        <div class="bg-gradient-to-r from-red-700 to-yellow-500 h-full" style="width: ${npc.level}%"></div>
                    </div>
                `;
                container.appendChild(block);
            });
        }


        // ================= MINI GAME REFLEX CHANNELS =================

        let activeMiniGame = null;

        function triggerMiniGame(gameKey) {
            playSound('click');
            activeMiniGame = gameKey;
            document.getElementById('gameplayScreen').classList.add('hidden');

            if (gameKey === 'football') {
                document.getElementById('miniGameFootball').classList.remove('hidden');
                attemptsShootout = 0;
                scoreShootout = 0;
                document.getElementById('shootoutAttemptsText').innerText = "0 / 5";
                document.getElementById('shootoutFeedbackText').innerText = "Shoot the corners to evade David!";
            } else if (gameKey === 'exam') {
                // Instantly open library for high study benefits
                document.getElementById('gameplayScreen').classList.remove('hidden');
                loadLocation('library');
                document.getElementById('labelDialogueText').innerText = "You sat in the silent Study Cabinets of the library, reading chemistry exam records. (+20 Intellect)";
                stats.intellect += 20;
                updateStatsBar();
            }
        }

        function exitMiniGame() {
            playSound('click');
            document.getElementById('miniGameFootball').classList.add('hidden');
            document.getElementById('gameplayScreen').classList.remove('hidden');
            activeMiniGame = null;
        }

        function kickShootout(target) {
            if (attemptsShootout >= 5) return;
            attemptsShootout++;

            const gk = document.getElementById('davidGoalkeeper');
            const moves = ['top-left', 'top-right', 'bottom-left', 'bottom-right'];
            const gkMove = moves[Math.floor(Math.random() * moves.length)];

            // Goalkeeper react positioning animation
            if (gkMove === 'top-left') gk.style.transform = 'translate(-60px, -20px)';
            else if (gkMove === 'top-right') gk.style.transform = 'translate(60px, -20px)';
            else if (gkMove === 'bottom-left') gk.style.transform = 'translate(-70px, 10px)';
            else if (gkMove === 'bottom-right') gk.style.transform = 'translate(70px, 10px)';

            setTimeout(() => {
                if (target === gkMove) {
                    playSound('damage');
                    document.getElementById('shootoutFeedbackText').innerHTML = "<span class='text-red-500'>SAVE! David read your kicking angle perfectly!</span>";
                } else {
                    playSound('item');
                    scoreShootout++;
                    document.getElementById('shootoutFeedbackText').innerHTML = "<span class='text-green-400'>GOOOOAL! Absolute precision kick!</span>";
                }

                document.getElementById('shootoutAttemptsText').innerText = `${attemptsShootout} / 5 attempts`;

                // Reset goalie
                setTimeout(() => {
                    gk.style.transform = 'translate(-50%, 0)';
                }, 1000);

                if (attemptsShootout === 5) {
                    setTimeout(() => {
                        if (scoreShootout >= 3) {
                            stats.aura += 30;
                            stats.speed += 15;
                            document.getElementById('shootoutFeedbackText').innerText = `Shootout match won! Score: ${scoreShootout}/5. (+30 Aura, +15 Speed)`;
                        } else {
                            stats.aura -= 10;
                            document.getElementById('shootoutFeedbackText').innerText = `Match lost. Score: ${scoreShootout}/5. David wins. (-10 Aura)`;
                        }
                        updateStatsBar();
                        setTimeout(exitMiniGame, 2000);
                    }, 1200);
                }

            }, 400);
        }


        // ================= FINAL SHOWDOWN vs ISI OWU =================

        let bossHP = 100;
        let playerFocus = 100;

        function startBossShowdown() {
            playSound('level');
            document.getElementById('gameplayScreen').classList.add('hidden');
            document.getElementById('bossBattleScreen').classList.remove('hidden');

            bossHP = 100;
            playerFocus = 100;

            // Set battle hero identifiers
            if (selectedCharacterKey === 'ifeoma') {
                document.getElementById('bossBattleHeroEmoji').innerText = "👧🏾";
                document.getElementById('bossBattleHeroName').innerText = "Ifeoma";
                document.getElementById('bossBattlePlayerLabel').innerText = "IFEOMA'S ACADEMIC STAMINA";
            } else {
                document.getElementById('bossBattleHeroEmoji').innerText = "😎";
                document.getElementById('bossBattleHeroName').innerText = "Michael";
                document.getElementById('bossBattlePlayerLabel').innerText = "MICHAEL'S REBEL AURA";
            }

            renderBossActions();
            updateBossMeters();
        }

        function updateBossMeters() {
            document.getElementById('bossHPText').innerText = `${bossHP} / 100 HP`;
            document.getElementById('bossHPBar').style.width = `${bossHP}%`;

            document.getElementById('playerHPText').innerText = `${playerFocus} / 100 Focus`;
            document.getElementById('playerHPBar').style.width = `${playerFocus}%`;
        }

        function renderBossActions() {
            const container = document.getElementById('bossBattleActionsContainer');
            container.innerHTML = '';

            let actions = [];
            if (selectedCharacterKey === 'ifeoma') {
                actions = [
                    { name: "STOCKING SHIFT", type: "heal", desc: "Confuses teacher and restores stamina", act: "ifeoma_stock" },
                    { name: "DYNAMIC RESPONSE", type: "attack", desc: "Crush him with perfect logic", act: "ifeoma_intel" },
                    { name: "REPUTATION GUARD", type: "shield", desc: "Block surprise test damage", act: "ifeoma_shield" },
                    { name: "CHEAT CODES", type: "extreme", desc: "Reveal past chemistry answers", act: "ifeoma_cheat" }
                ];
            } else {
                actions = [
                    { name: "HOODIE STYLED WALK", type: "heal", desc: "Stun hallways and heal focus", act: "michael_hood" },
                    { name: "ROLLING LOUD BURST", type: "attack", desc: "Ultimate energy wave attack", act: "michael_loud" },
                    { name: "COSMIC COUNTER", type: "shield", desc: "Deflect detention strikes", act: "michael_counter" },
                    { name: "TREVOR'S PRANK", type: "extreme", desc: "Create high classroom chaos", act: "michael_prank" }
                ];
            }

            actions.forEach(a => {
                const btn = document.createElement('button');
                btn.className = "bg-[#1f0d19] hover:bg-red-950/40 border border-red-900/40 text-stone-100 p-2.5 rounded-xl font-bold text-xs uppercase flex flex-col items-center justify-center text-center transition active:scale-95";
                btn.innerHTML = `
                    <span>${a.name}</span>
                    <span class="text-[9px] font-normal text-stone-400 mt-1">${a.desc}</span>
                `;
                btn.onclick = () => executeShowdownAction(a.act);
                container.appendChild(btn);
            });
        }

        function executeShowdownAction(action) {
            playSound('attack');
            let damage = 0;
            let heal = 0;
            let msg = "";

            if (action === 'ifeoma_stock') {
                heal = 30;
                msg = "Ifeoma folds her stockings perfectly straight. Isi Owu stops his homework attack, completely baffled by her high-school swagger! (+30 Focus)";
            } else if (action === 'ifeoma_intel' || action === 'michael_loud') {
                damage = 25 + Math.floor(Math.random() * 10);
                msg = `A massive clash of theories! Your ultimate counter-reasoning strikes down Isi Owu's WAEC barrier by ${damage} points!`;
            } else if (action === 'ifeoma_shield' || action === 'michael_counter') {
                heal = 15;
                damage = 10;
                msg = "You predict his question and raise a textbook shield! Absorbed incoming damage and counter-struck for 10 damage!";
            } else if (action === 'ifeoma_cheat') {
                damage = 40;
                msg = "You reveal the complete past examination cheats Amara gave you. Isi Owu\'s test papers dissolve! Dealing 40 damage!";
            } else if (action === 'michael_hood') {
                heal = 35;
                msg = "Michael adjusts his 'ROLLING LOUD' hood with cool caramel skin focus. 'This is how we roll, Sir.' (+35 Focus)";
            } else if (action === 'michael_prank') {
                damage = 40;
                msg = "Trevor sets off a fireworks show in the chemistry cabinets. Isi Owu panics, dropping his grade files! Dealing 40 damage!";
            }

            bossHP = Math.max(0, bossHP - damage);
            playerFocus = Math.min(100, playerFocus + heal);
            updateBossMeters();

            document.getElementById('bossBattleLog').innerText = msg;

            // Trigger visual crash sign
            const indicator = document.getElementById('bossClashIndicator');
            indicator.innerText = "💥";
            indicator.className = "text-5xl animate-ping font-extrabold text-red-500 z-10";
            setTimeout(() => {
                indicator.innerText = "⚡";
                indicator.className = "text-4xl animate-bounce font-bold text-red-500 z-10";
            }, 600);

            if (bossHP <= 0) {
                setTimeout(showEndingVictory, 1500);
                return;
            }

            // Disable combat panel during teacher turn
            toggleCombatButtons(false);

            setTimeout(executeIsiOwuTurn, 1500);
        }

        function toggleCombatButtons(enable) {
            const btns = document.getElementById('bossBattleActionsContainer').querySelectorAll('button');
            btns.forEach(b => b.disabled = !enable);
        }

        function executeIsiOwuTurn() {
            playSound('damage');
            const mainScr = document.getElementById('mainContainer');
            mainScr.classList.add('shake-active');
            setTimeout(() => mainScr.classList.remove('shake-active'), 500);

            const counterAttacks = [
                { name: "CONFISCATION EYE BEAM", val: 15, txt: "Isi Owu shoots a red ray! 'GIVE ME THAT CONTRABAND SNARE!' You lose 15 Focus!" },
                { name: "HOMEWORK TSUNAMI", val: 20, txt: "A storm of red marked scripts strikes your shield! You lose 20 Focus!" },
                { name: "DETENTION GAVEL", val: 25, txt: "A massive floating grade-book slams the floor. You lose 25 Focus!" }
            ];

            const attack = counterAttacks[Math.floor(Math.random() * counterAttacks.length)];
            playerFocus = Math.max(0, playerFocus - attack.val);
            updateBossMeters();

            document.getElementById('bossBattleLog').innerHTML = `<span class="text-red-500 font-bold">${attack.name}</span>: ${attack.txt}`;

            if (playerFocus <= 0) {
                setTimeout(showEndingDefeat, 1500);
                return;
            }

            toggleCombatButtons(true);
        }

        function showEndingVictory() {
            document.getElementById('bossBattleScreen').classList.add('hidden');
            document.getElementById('endingScreen').classList.remove('hidden');

            if (selectedCharacterKey === 'ifeoma') {
                document.getElementById('endingBadge').innerText = "👑🎒";
                document.getElementById('endingTitle').innerText = "Academic Legend: Ifeoma's Victory";
                document.getElementById('endingDescription').innerHTML = `
                    <b>Incredible achievement!</b> You triumphed as Ifeoma! You cleared the WAEC trials with 100% scores. <br><br>
                    Isi Owu smiles warmly and adjusts his glasses: <i>"Ifeoma, you truly are the academic pride of Melting Point College."</i> Michael walks over, slaps your hand, and congratulates his study rival. You have become an absolute legend!
                `;
            } else {
                document.getElementById('endingBadge').innerText = "😎🔥";
                document.getElementById('endingTitle').innerText = "Aura King: Michael's Legend";
                document.getElementById('endingDescription').innerHTML = `
                    <b>Pure Main Character Energy!</b> You defeated Isi Owu as Michael! Your ROLLING LOUD hoodie shines with infinite purple aura. <br><br>
                    The school gate erupts in cheers. Ifeoma adjustments her high socks and smiles: <i>"Okay Rebel, you got swag."</i> Trevor declares you the absolute hallway idol of Melting Point!
                `;
            }
        }

        function showEndingDefeat() {
            document.getElementById('bossBattleScreen').classList.add('hidden');
            document.getElementById('endingScreen').classList.remove('hidden');

            document.getElementById('endingBadge').innerText = "🧹💀";
            document.getElementById('endingTitle').innerText = "Assembly Detention Ending";
            document.getElementById('endingDescription').innerHTML = `
                Isi Owu towers tall over your sheet. <i>"I TOLD YOU TO READ!"</i> <br><br>
                You ran completely out of focus, your contraband materials got locked up, and you've been assigned 3 weeks of morning sweeping duties. Re-align your stats and try again!
            `;
        }

        function restartRpg() {
            playSound('click');
            document.getElementById('endingScreen').classList.add('hidden');
            document.getElementById('characterSelectScreen').classList.remove('hidden');
        }
    </script>
</body>
</html>
