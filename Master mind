            backdrop-filter: blur(16px);
            border: 1px solid rgba(157, 23, 29, 0.4);
        }
        /* Anime Glowing Effects */
        .glow-red {
            box-shadow: 0 0 20px rgba(157, 23, 29, 0.6);
        }
        .glow-purple {
            box-shadow: 0 0 20px rgba(139, 92, 246, 0.6);
        }
        .glow-gold {
            box-shadow: 0 0 20px rgba(234, 179, 8, 0.6);
        }
        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f060c;
        }
        ::-webkit-scrollbar-thumb {
            background: #9d171d;
            border-radius: 4px;
        }
